#: ../contents/config/config.qml
msgid "Rules"
msgstr "Rules"

#: ../contents/config/config.qml
msgid "General"
msgstr "General"

#: ../contents/ui/configGeneral.qml
msgid "Notifications:"
msgstr "Notificaciones:"

#: ../contents/ui/configGeneral.qml
msgid "Show notification after each operation"
msgstr "Mostrar notificación luego de cada operación"

#: ../contents/ui/configGeneral.qml
msgid "If the file already exists:"
msgstr "Si el archivo ya existe:"

#: ../contents/ui/configGeneral.qml
msgid "Skip (do not move)"
msgstr "Omitir (no mover)"

#: ../contents/ui/configGeneral.qml
msgid "Keep both (rename: [filename]_1.ext)"
msgstr "Mantener ambos (renombrar: [archivo]_1.ext)"

#: ../contents/ui/configGeneral.qml
msgid "Overwrite"
msgstr "Sobreescribir"

#: ../contents/ui/configGeneral.qml
msgid ""
"⚠  Files are moved permanently.\n"
"Carefully check the rules and destination folders before using them with "
"important files."
msgstr ""
"⚠  Los archivos se mueven de forma permanente.\n"
"Verificá bien las reglas y carpetas destino antes de usarlas con archivos "
"importantes."

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules"
msgstr "Restaurar reglas predeterminadas"

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules?"
msgstr "¿Restaurar reglas predeterminadas?"

#: ../contents/ui/configGeneral.qml
msgid ""
"This will remove all custom rules and restore the 9 predefined categories "
"(disabled). Continue?"
msgstr ""
"Esto eliminará todas las reglas personalizadas y restaurará las 9 categorías "
"predefinidas (desactivadas). ¿Continuar?"

#: ../contents/ui/configRules.qml
msgid "Add rule"
msgstr "Agregar regla"

#: ../contents/ui/configRules.qml
msgid "There are no set rules."
msgstr "No hay reglas definidas"

#: ../contents/ui/configRules.qml
msgid "Click \"Add rule\" to get started."
msgstr "Hacé clic en \\\"Agregar regla\\\" para comenzar"

#: ../contents/ui/configRules.qml
msgid "Set up a destination folder first."
msgstr "Configurá una carpeta destino primero"

#: ../contents/ui/configRules.qml
msgid "Deactivate"
msgstr "Desactivar"

#: ../contents/ui/configRules.qml
msgid "Activate"
msgstr "Activar"

#: ../contents/ui/configRules.qml
msgid "⚠ No destination folder — click Edit"
msgstr "⚠ Sin carpeta destino — hacé clic en editar"

#: ../contents/ui/configRules.qml
msgid "Edit"
msgstr "Editar"

#: ../contents/ui/configRules.qml
msgid "Go up"
msgstr "Subir"

#: ../contents/ui/configRules.qml
msgid "Lower"
msgstr "Bajar"

#: ../contents/ui/configRules.qml
msgid "Eliminate"
msgstr "Eliminar"

#: ../contents/ui/configRules.qml
msgid "Edit rule"
msgstr "Editar regla"

#: ../contents/ui/configRules.qml
msgid "Name:"
msgstr "Nombre:"

#: ../contents/ui/configRules.qml
