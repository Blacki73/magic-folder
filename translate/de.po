#: ../contents/config/config.qml
msgid "Rules"
msgstr "Regeln"

#: ../contents/config/config.qml
msgid "General"
msgstr "Allgemein"

#: ../contents/ui/configGeneral.qml
msgid "Notifications:"
msgstr "Benachrichtigungen:"

#: ../contents/ui/configGeneral.qml
msgid "Show notification after each operation"
msgstr "Benachrichtigung nach jeder operation"

#: ../contents/ui/configGeneral.qml
msgid "If the file already exists:"
msgstr "Wenn die Datei bereits existiert"

#: ../contents/ui/configGeneral.qml
msgid "Skip (do not move)"
msgstr "Überspringen (nicht verschieben)"

#: ../contents/ui/configGeneral.qml
msgid "Keep both (rename: [filename]_1.ext)"
msgstr "Beide beibehalten (umbenennen in: [dateiname]_1.ext)"

#: ../contents/ui/configGeneral.qml
msgid "Overwrite"
msgstr "Überschreiben"

#: ../contents/ui/configGeneral.qml
msgid ""
"⚠  Files are moved permanently.\n"
"Carefully check the rules and destination folders before using them with "
"important files."
msgstr ""
"⚠  Dateien werden endgültig verschoben.\n"
"Überprüfen Sie die Regeln und Zielordner sorgfältig, bevor Sie sie für "
"wichtige Dateien verwenden."

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules"
msgstr "Standardregeln wiederherstellen"

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules?"
msgstr "Standardregeln wiederherstellen?"

#: ../contents/ui/configGeneral.qml
msgid ""
"This will remove all custom rules and restore the 9 predefined categories "
"(disabled). Continue?"
msgstr ""
"Dadurch werden alle benutzerdefinierten Regeln entfernt und die 9 "
"vordefinierten Kategorien wiederhergestellt (deaktiviert). Fortfahren?"

#: ../contents/ui/configRules.qml
msgid "Add rule"
msgstr "Neue Regel"

#: ../contents/ui/configRules.qml
msgid "There are no set rules."
msgstr "Keine Regeln"

#: ../contents/ui/configRules.qml
msgid "Click \"Add rule\" to get started."
msgstr "\"Neue Regel\" anklicken um zu beginnen."

#: ../contents/ui/configRules.qml
msgid "Set up a destination folder first."
msgstr "zuerst Zielordner auswählen."

#: ../contents/ui/configRules.qml
msgid "Deactivate"
msgstr "Deaktivieren"

#: ../contents/ui/configRules.qml ../contents/ui/main.qml
