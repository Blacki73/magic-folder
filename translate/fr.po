#: ../contents/config/config.qml
msgid "Rules"
msgstr "Règles"

#: ../contents/config/config.qml
msgid "General"
msgstr "Général"

#: ../contents/ui/configGeneral.qml
msgid "Notifications:"
msgstr "Notifications :"

#: ../contents/ui/configGeneral.qml
msgid "Show notification after each operation"
msgstr "Afficher une notification après chaque opération"

#: ../contents/ui/configGeneral.qml
msgid "If the file already exists:"
msgstr "Si le fichier existe déjà :"

#: ../contents/ui/configGeneral.qml
msgid "Skip (do not move)"
msgstr "Ignorer (ne pas déplacer)"

#: ../contents/ui/configGeneral.qml
msgid "Keep both (rename: [filename]_1.ext)"
msgstr "Conserver les deux (renommer en : [filename]_1.ext)"

#: ../contents/ui/configGeneral.qml
msgid "Overwrite"
msgstr "Écraser"

#: ../contents/ui/configGeneral.qml
msgid ""
"⚠  Files are moved permanently.\n"
"Carefully check the rules and destination folders before using them with "
"important files."
msgstr ""
"⚠  Les fichiers sont déplacés définitivement.\n"
"Vérifiez attentivement les règles et les dossiers de destination avant de "
"les utiliser avec des fichiers importants."

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules"
msgstr "Restaurer les règles par défaut"

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules?"
msgstr "Restaurer les règles par défaut ?"

#: ../contents/ui/configGeneral.qml
msgid ""
"This will remove all custom rules and restore the 9 predefined categories "
"(disabled). Continue?"
msgstr ""
"Cette action supprimera toutes les règles personnalisées et restaurera les 9 "
"catégories prédéfinies (désactivées). Continuer ?"

#: ../contents/ui/configRules.qml
msgid "Add rule"
msgstr "Ajouter une règle"

#: ../contents/ui/configRules.qml
msgid "There are no set rules."
msgstr "Aucune règle n'est définie."

#: ../contents/ui/configRules.qml
msgid "Click \"Add rule\" to get started."
msgstr "Cliquez sur « Ajouter une règle » pour commencer."

#: ../contents/ui/configRules.qml
msgid "Set up a destination folder first."
msgstr "Configurez d'abord un dossier de destination."

#: ../contents/ui/configRules.qml
msgid "Deactivate"
msgstr "Désactiver"

#: ../contents/ui/configRules.qml
msgid "Activate"
msgstr "Activer"

#: ../contents/ui/configRules.qml
msgid "⚠ No destination folder — click Edit"
msgstr "⚠ Aucun dossier de destination — cliquez sur Modifier"

#: ../contents/ui/configRules.qml
msgid "Edit"
msgstr "Modifier"

#: ../contents/ui/configRules.qml
msgid "Go up"
msgstr "Monter"

#: ../contents/ui/configRules.qml
msgid "Lower"
msgstr "Descendre"

#: ../contents/ui/configRules.qml
msgid "Eliminate"
msgstr "Supprimer"

#: ../contents/ui/configRules.qml
msgid "Edit rule"
msgstr "Modifier la règle"

#: ../contents/ui/configRules.qml
msgid "Name:"
msgstr "Nom :"

#: ../contents/ui/configRules.qml
msgid "E.g.: Videos"
msgstr "Ex. : Vidéos"

#: ../contents/ui/configRules.qml
msgid "Extensions:"
msgstr "Extensions :"

#: ../contents/ui/configRules.qml
msgid "mp4, mkv, avi"
msgstr "mp4, mkv, avi"

#: ../contents/ui/configRules.qml
msgid "Destination folder:"
msgstr "Dossier de destination :"

#: ../contents/ui/configRules.qml
msgid "/home/[username]/Videos"
msgstr "/home/[username]/Vidéos"

#: ../contents/ui/configRules.qml
msgid "Explore…"
msgstr "Parcourir…"

#: ../contents/ui/configRules.qml
msgid "Icon (optional):"
msgstr "Icône (facultatif) :"

#: ../contents/ui/configRules.qml
msgid "video-x-generic"
msgstr "video-x-generic"

#: ../contents/ui/configRules.qml
msgid ""
"Suggested icons: video-x-generic · audio-x-generic · image-x-generic · x-"
"office-document · application-zip · text-x-script · application-x-executable "
"· application-epub+zip"
msgstr ""
"Icônes suggérées : video-x-generic · audio-x-generic · image-x-generic · x-"
"office-document · application-zip · text-x-script · application-x-executable "
"· application-epub+zip"

#: ../contents/ui/main.qml
msgid "Video"
msgstr "Vidéos"

#: ../contents/ui/main.qml
msgid "Audio"
msgstr "Audio"

#: ../contents/ui/main.qml
msgid "Images"
msgstr "Images"

#: ../contents/ui/main.qml
msgid "Documents"
msgstr "Documents"

#: ../contents/ui/main.qml
msgid "Ebooks"
msgstr "Livres électroniques"

#: ../contents/ui/main.qml
msgid "Archives"
msgstr "Archives"

#: ../contents/ui/main.qml
msgid "APKs"
msgstr "APK"

#: ../contents/ui/main.qml
msgid "Source code"
msgstr "Code source"

#: ../contents/ui/main.qml
msgid "Binaris"
msgstr "Fichiers binaires"

#: ../contents/ui/main.qml
msgid "Configure Magic Folder…"
msgstr "Configurer Magic Folder…"

#: ../contents/ui/main.qml
msgid "Drop files onto the panel icon to move them automatically."
msgstr ""
"Déposez des fichiers sur l'icône du panneau pour les déplacer "
"automatiquement."

#: ../contents/ui/main.qml
msgid "Active rules: %1 of %2"
msgstr "Règles actives : %1 sur %2"

#: ../contents/ui/main.qml
msgid "Configure rules…"
msgstr "Configurer les règles…"
