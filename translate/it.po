#: ../contents/config/config.qml
msgid "Rules"
msgstr "Regole"

#: ../contents/config/config.qml
msgid "General"
msgstr "Generale"

#: ../contents/ui/configGeneral.qml
msgid "Notifications:"
msgstr "Notifiche:"

#: ../contents/ui/configGeneral.qml
msgid "Show notification after each operation"
msgstr "Mostra una notifica dopo ogni operazione"

#: ../contents/ui/configGeneral.qml
msgid "If the file already exists:"
msgstr "Se il file esiste già:"

#: ../contents/ui/configGeneral.qml
msgid "Skip (do not move)"
msgstr "Ignora (non spostare)"

#: ../contents/ui/configGeneral.qml
msgid "Keep both (rename: [filename]_1.ext)"
msgstr "Mantieni entrambi (rinomina in: [filename]_1.ext)"

#: ../contents/ui/configGeneral.qml
msgid "Overwrite"
msgstr "Sovrascrivi"

#: ../contents/ui/configGeneral.qml
msgid ""
"⚠  Files are moved permanently.\n"
"Carefully check the rules and destination folders before using them with "
"important files."
msgstr ""
"⚠  I file vengono spostati definitivamente.\n"
"Controlla attentamente le regole e le cartelle di destinazione prima di "
"utilizzarle con file importanti."

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules"
msgstr "Ripristina le regole predefinite"

#: ../contents/ui/configGeneral.qml
msgid "Restore default rules?"
msgstr "Ripristinare le regole predefinite?"

#: ../contents/ui/configGeneral.qml
msgid ""
"This will remove all custom rules and restore the 9 predefined categories "
"(disabled). Continue?"
msgstr ""
"Questa operazione rimuoverà tutte le regole personalizzate e ripristinerà le "
"9 categorie predefinite (disattivate). Continuare?"

#: ../contents/ui/configRules.qml
msgid "Add rule"
msgstr "Aggiungi regola"

#: ../contents/ui/configRules.qml
msgid "There are no set rules."
msgstr "Non ci sono regole impostate."

#: ../contents/ui/configRules.qml
msgid "Click \"Add rule\" to get started."
msgstr "Fai clic su «Aggiungi regola» per iniziare."

#: ../contents/ui/configRules.qml
msgid "Set up a destination folder first."
msgstr "Imposta prima una cartella di destinazione."

#: ../contents/ui/configRules.qml
msgid "Deactivate"
msgstr "Disattiva"

#: ../contents/ui/configRules.qml
msgid "Activate"
msgstr "Attiva"

#: ../contents/ui/configRules.qml
msgid "⚠ No destination folder — click Edit"
msgstr "⚠ Nessuna cartella di destinazione — fai clic su Modifica"

#: ../contents/ui/configRules.qml
msgid "Edit"
msgstr "Modifica"

#: ../contents/ui/configRules.qml
msgid "Go up"
msgstr "Sposta su"

#: ../contents/ui/configRules.qml
msgid "Lower"
msgstr "Sposta giù"

#: ../contents/ui/configRules.qml
msgid "Eliminate"
msgstr "Elimina"

#: ../contents/ui/configRules.qml
msgid "Edit rule"
msgstr "Modifica regola"

#: ../contents/ui/configRules.qml
msgid "Name:"
msgstr "Nome:"

#: ../contents/ui/configRules.qml
msgid "E.g.: Videos"
msgstr "Es.: Video"

#: ../contents/ui/configRules.qml
msgid "Extensions:"
msgstr "Estensioni:"

#: ../contents/ui/configRules.qml
msgid "mp4, mkv, avi"
msgstr "mp4, mkv, avi"

#: ../contents/ui/configRules.qml
msgid "Destination folder:"
msgstr "Cartella di destinazione:"

#: ../contents/ui/configRules.qml
msgid "/home/[username]/Videos"
msgstr "/home/[username]/Video"

#: ../contents/ui/configRules.qml
msgid "Explore…"
msgstr "Sfoglia…"

#: ../contents/ui/configRules.qml
msgid "Icon (optional):"
msgstr "Icona (opzionale):"

#: ../contents/ui/configRules.qml
msgid "video-x-generic"
msgstr "video-x-generic"

#: ../contents/ui/configRules.qml
msgid ""
"Suggested icons: video-x-generic · audio-x-generic · image-x-generic · x-"
"office-document · application-zip · text-x-script · application-x-executable "
"· application-epub+zip"
msgstr ""
"Icone suggerite: video-x-generic · audio-x-generic · image-x-generic · x-"
"office-document · application-zip · text-x-script · application-x-executable "
"· application-epub+zip"

#: ../contents/ui/main.qml
msgid "Video"
msgstr "Video"

#: ../contents/ui/main.qml
msgid "Audio"
msgstr "Audio"

#: ../contents/ui/main.qml
msgid "Images"
msgstr "Immagini"

#: ../contents/ui/main.qml
msgid "Documents"
msgstr "Documenti"

#: ../contents/ui/main.qml
msgid "Ebooks"
msgstr "E-book"

#: ../contents/ui/main.qml
msgid "Archives"
msgstr "Archivi"

#: ../contents/ui/main.qml
msgid "APKs"
msgstr "APK"

#: ../contents/ui/main.qml
msgid "Source code"
msgstr "Codice sorgente"

#: ../contents/ui/main.qml
msgid "Binaris"
msgstr "File binari"

#: ../contents/ui/main.qml
msgid "Configure Magic Folder…"
msgstr "Configura Magic Folder…"

#: ../contents/ui/main.qml
msgid "Drop files onto the panel icon to move them automatically."
msgstr "Trascina i file sull'icona del pannello per spostarli automaticamente."

#: ../contents/ui/main.qml
msgid "Active rules: %1 of %2"
msgstr "Regole attive: %1 di %2"

#: ../contents/ui/main.qml
msgid "Configure rules…"
